/* =========================================
   UTILITIES
========================================= */

const $ = id => document.getElementById(id);

function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, c => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  }[c]));
}

function formatDate(date) {
  if (!date) return "-";

  const d = new Date(date);

  if (Number.isNaN(d.getTime())) {
    return String(date);
  }

  return d.toLocaleDateString("th-TH", {
    day: "numeric",
    month: "short",
    year: "numeric"
  });
}

function setText(id, value) {
  $(id).textContent = value;
}

function getStatusClass(status) {
  if (status === "แล้วเสร็จ") return "done";
  if (status === "เกินกำหนด") return "late";
  if (status === "ใกล้ครบกำหนด") return "soon";
  return "progress";
}


/* =========================================
   CHARTS
========================================= */

let statusChart;
let categoryChart;
let trendChart;

function renderCharts(data) {

  if (typeof Chart === "undefined") {
    console.warn("Chart.js ไม่สามารถโหลดได้");
    return;
  }

  const s = data.summary;

  if (statusChart) statusChart.destroy();
  if (categoryChart) categoryChart.destroy();
  if (trendChart) trendChart.destroy();

  statusChart = new Chart($("statusChart"), {
    type: "doughnut",

    data: {
      labels: [
        "แล้วเสร็จ",
        "กำลังดำเนินการ",
        "ใกล้ครบกำหนด",
        "เกินกำหนด"
      ],

      datasets: [{
        data: [
          s.completed,
          s.inProgress,
          s.upcoming,
          s.overdue
        ],

        backgroundColor: [
          "#18a34a",
          "#287dff",
          "#f5a623",
          "#e52d40"
        ],

        borderWidth: 2
      }]
    },

    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: "bottom"
        }
      }
    }
  });

  categoryChart = new Chart($("categoryChart"), {
    type: "bar",

    data: {
      labels: data.categories.map(x => x.name),

      datasets: [{
        label: "จำนวนงาน",
        data: data.categories.map(x => x.total),
        backgroundColor: "#2379ee",
        borderRadius: 6
      }]
    },

    options: {
      responsive: true,
      maintainAspectRatio: false,

      plugins: {
        legend: {
          display: false
        }
      },

      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            precision: 0
          }
        }
      }
    }
  });

  trendChart = new Chart($("trendChart"), {
    type: "line",

    data: {
      labels: data.trend.labels,

      datasets: [{
        label: "ความสำเร็จ (%)",
        data: data.trend.values,
        borderColor: "#1769ff",
        backgroundColor: "#1769ff20",
        fill: true,
        tension: 0.35,
        pointRadius: 5
      }]
    },

    options: {
      responsive: true,
      maintainAspectRatio: false,

      scales: {
        y: {
          min: 0,
          max: 100
        }
      }
    }
  });

}


/* =========================================
   RENDER DASHBOARD
========================================= */

function renderDashboard(data) {

  const s = data.summary;

  setText("totalTasks", s.total);
  setText("completedTasks", s.completed);
  setText("progressTasks", s.inProgress);
  setText("overdueTasks", s.overdue);
  setText("upcomingTasks", s.upcoming);

  const rate = s.total > 0
    ? ((s.completed / s.total) * 100).toFixed(1)
    : "0.0";

  setText("successRate", rate + "%");

  renderCharts(data);
  renderUrgentTasks(data.urgentTasks || []);
  renderPersonnel(data.personnel || []);
  renderMOU(data.mou || []);
  renderSources(data.sources || []);

  setText(
    "lastUpdate",
    "ข้อมูลล่าสุด: " +
    new Date().toLocaleTimeString("th-TH")
  );

}


/* =========================================
   URGENT TASKS
========================================= */

function renderUrgentTasks(tasks) {

  const tbody = $("urgentTable");

  if (!tasks.length) {
    tbody.innerHTML =
      '<tr><td colspan="4">ไม่มีรายการงานเร่งด่วน</td></tr>';
    return;
  }

  tbody.innerHTML = tasks.map(t => `
    <tr>
      <td>${escapeHTML(t.name)}</td>
      <td>${escapeHTML(t.responsible)}</td>
      <td>${escapeHTML(formatDate(t.dueDate))}</td>
      <td>
        <span class="status ${getStatusClass(t.status)}">
          ${escapeHTML(t.status)}
        </span>
      </td>
    </tr>
  `).join("");

}


/* =========================================
   PERSONNEL
========================================= */

function renderPersonnel(items) {

  $("personnelTable").innerHTML = items.map(p => {

    const pending = Math.max(
      0,
      Number(p.total) - Number(p.completed)
    );

    return `
      <tr>
        <td>${escapeHTML(p.name)}</td>
        <td>${Number(p.total)}</td>
        <td>${Number(p.completed)}</td>
        <td>${pending}</td>
      </tr>
    `;

  }).join("");

}


/* =========================================
   MOU
========================================= */

function renderMOU(items) {

  $("mouTable").innerHTML = items.map(m => `
    <tr>
      <td>${escapeHTML(m.id)}</td>
      <td>${escapeHTML(m.name)}</td>
      <td>${escapeHTML(m.responsible)}</td>
      <td>
        <progress
          value="${Math.min(100, Math.max(0, Number(m.progress) || 0))}"
          max="100">
        </progress>
        ${Number(m.progress) || 0}%
      </td>
      <td>
        <span class="status ${getStatusClass(m.status)}">
          ${escapeHTML(m.status)}
        </span>
      </td>
    </tr>
  `).join("");

}


/* =========================================
   GOOGLE SHEETS SOURCES
========================================= */

function renderSources(sources) {

  if (!sources.length) {
    $("dataSources").textContent = "ยังไม่มีแหล่งข้อมูล";
    return;
  }

  $("dataSources").innerHTML = sources.map(s => {

    const state = s.status === "connected"
      ? "● เชื่อมต่อ"
      : s.status === "demo"
      ? "● ตัวอย่าง"
      : "● ไม่พร้อมใช้งาน";

    return `
      <div class="source">

        <div>
          <div class="source-name">
            ${escapeHTML(s.name)}
          </div>

          <small>
            ${Number(s.sheets) || 0} ชีต
          </small>
        </div>

        <span class="source-state">
          ${state}
        </span>

      </div>
    `;

  }).join("");

}


/* =========================================
   GOOGLE SHEETS API
========================================= */

async function fetchDashboardData() {

  if (!CONFIG.apiUrl) {
    throw new Error("ยังไม่ได้กำหนด API URL");
  }

  const response = await fetch(CONFIG.apiUrl, {
    method: "GET",
    cache: "no-store"
  });

  if (!response.ok) {
    throw new Error(
      "API Error: " + response.status
    );
  }

  const result = await response.json();

  if (!result || !result.summary) {
    throw new Error("รูปแบบข้อมูล API ไม่ถูกต้อง");
  }

  return result;

}


/* =========================================
   LOAD DATA
========================================= */

let isLoading = false;

async function loadDashboard() {

  if (isLoading) return;

  isLoading = true;

  const badge = $("connectionStatus");

  try {

    if (CONFIG.demoMode) {

      renderDashboard(DEMO_DATA);

      badge.className = "badge demo";
      badge.textContent = "🟠 ข้อมูลตัวอย่าง";

    } else {

      badge.textContent = "🔄 กำลังเชื่อมต่อ...";

      const data = await fetchDashboardData();

      renderDashboard(data);

      badge.className = "badge online";
      badge.textContent = "🟢 เชื่อมต่อ Google Sheets";

    }

  } catch (error) {

    console.error(error);

    badge.className = "badge offline";
    badge.textContent = "🔴 เชื่อมต่อไม่สำเร็จ";

    setText(
      "lastUpdate",
      "ไม่สามารถดึงข้อมูลใหม่ได้: " + error.message
    );

  } finally {

    isLoading = false;

  }

}


/* =========================================
   INITIALIZATION
========================================= */

function updateClock() {

  const now = new Date();

  setText(
    "currentDate",
    now.toLocaleDateString("th-TH", {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric"
    })
  );

}

updateClock();

setInterval(updateClock, 60000);

loadDashboard();

setInterval(
  loadDashboard,
  CONFIG.refreshInterval
);

</script>

