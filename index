    { name: "เจ้าหน้าที่ C", total: 14, completed: 9 },
    { name: "เจ้าหน้าที่ D", total: 12, completed: 8 }
  ],

  mou: [
    {
      id: "MOU-001",
      name: "ติดตามงานตามข้อตกลงข้อ 1",
      responsible: "งานธุรการ",
      progress: 100,
      status: "แล้วเสร็จ"
    },
    {
      id: "MOU-002",
      name: "ติดตามงานตามข้อตกลงข้อ 2",
      responsible: "งานการเงิน",
      progress: 75,
      status: "กำลังดำเนินการ"
    },
    {
